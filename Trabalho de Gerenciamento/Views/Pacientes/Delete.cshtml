
@model Trabalho_de_Gerenciamento.Models.Pacientes

@{
    // Define o título da página
    ViewData["Title"] = "Excluir Paciente";
}

<!-- Título da página -->
<h1>Excluir Paciente</h1>

<!-- Mensagem de confirmação antes da exclusão -->
<h3>Tem certeza que deseja excluir este paciente?</h3>

<!-- Exibe os dados do paciente que será excluído -->
<div>
    <dl class="row">

        <!-- Nome do paciente -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>

        <!-- CPF do paciente -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CPF)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CPF)
        </dd>

        <!-- Telefone do paciente -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Telefone)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Telefone)
        </dd>

        <!-- Endereço do paciente -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Endereco)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Endereco)
        </dd>

        <!-- Data de nascimento do paciente -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataNascimento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DataNascimento)
        </dd>

    </dl>
</div>

<!-- Formulário responsável por confirmar a exclusão -->
<form asp-action="Delete" method="post">

    <!-- Mantém o ID do paciente que será excluído -->
    <input type="hidden" asp-for="Id" />

    <!-- Botão que confirma a exclusão -->
    <button type="submit" class="btn btn-danger">Excluir</button>

    <!-- Retorna para a lista sem excluir o paciente -->
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>

</form>

