@model Trabalho_de_Gerenciamento.Models.Pacientes
{
ViewData["Title"] = "Editar Paciente";
}

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Nome"></label>
        <input asp-for="Nome" />
    </div>

    <div>
        <label asp-for="CPF"></label>
        <input asp-for="CPF" />
    </div>

    <div>
        <label asp-for="Telefone"></label>
        <input asp-for="Telefone" />
    </div>

    <div>
        <label asp-for="Endereco"></label>
        <input asp-for="Endereco" />
    </div>

    <div>
        <label asp-for="DataNascimento"></label>
        <input asp-for="DataNascimento" type="date" />
    </div>

    <button type="submit">Salvar</button>

</form>

